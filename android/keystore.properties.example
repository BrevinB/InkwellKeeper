# Copy to keystore.properties (git-ignored) to sign release builds with the Play upload key.
# Create the key once with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Back the .jks and passwords up somewhere safe (a password manager) — Play App Signing can reset a lost
# upload key, but it takes a support request.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
